root = true

[*]
charset = utf-8
end_of_line = lf
trim_trailing_whitespace = true
insert_final_newline = true

[*.{lua,xml,toc}]
indent_style = tab
tab_width = 4

# Bundled third-party libraries — keep upstream formatting untouched
[{ElvUI_Libraries,*/Libraries}/**.{lua,xml,toc}]
trim_trailing_whitespace = false
insert_final_newline = unset

[*.md]
trim_trailing_whitespace = false

[*.{json,yml,yaml,gitattributes,gitignore}]
indent_style = space
indent_size = 2
