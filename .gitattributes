# ─── Line endings ────────────────────────────────────────
# Normalize all text to LF in the repo and on checkout (matches .editorconfig eol=lf)
* text=auto eol=lf

# ─── Source & text files ─────────────────────────────────
*.lua   text eol=lf diff=lua
*.xml   text eol=lf
*.toc   text eol=lf
*.md    text eol=lf
*.txt   text eol=lf
*.json  text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf

# ─── Binary assets (no EOL conversion, no diff) ──────────
*.tga   binary
*.blp   binary
*.ogg   binary
*.mp3   binary
*.wav   binary
*.ttf   binary
*.otf   binary
*.png   binary
*.zip   binary

# ─── GitHub linguist ─────────────────────────────────────
# Bundled third-party libraries are vendored: exclude from language stats, collapse in diffs
ElvUI_Libraries/**   linguist-vendored
*/Libraries/**       linguist-vendored

# ─── Archive export (git archive / addon packagers) ──────
# Strip development-only files from exported/packaged builds
.github         export-ignore
.githooks       export-ignore
.gitattributes  export-ignore
.gitignore      export-ignore
.editorconfig   export-ignore
.luarc.json     export-ignore
.styluaignore   export-ignore
justfile        export-ignore
stylua.toml     export-ignore
README.md       export-ignore
